 "terms": {
  "CHEBI:85984": {
   "name": "avibactam",
   "definition": "A member of the class of azabicycloalkanes that is (2<i>S</i>,5<i>R</i>)-7-oxo-1,6-diazabicyclo[3.2.1]octane-2-carboxamide in which the amino hydrogen at position 6 is replaced by a sulfooxy group. Used (in the form of its sodium salt) in combination with ceftazidime pentahydrate for the treatment of complicated urinary tract infections including pyelonephritis.",
